+/*
+ * Preserve ordinary in-range inode values, but synthesize every identity
+ * that participates in hardlink matching and every inode that cannot fit in
+ * the newc field.  The full device/inode tuple is the source identity.
+ */
+static int
+synthesize_ino_value(struct cpio *cpio, struct archive_entry *entry,
+    uint32_t *ino_new)
+{
+	int64_t devmajor, devminor, ino;
+	size_t i;
+
+	devmajor = archive_entry_devmajor(entry);
+	devminor = archive_entry_devminor(entry);
+	ino = archive_entry_ino64(entry);
+
+	/* Preserve the end marker and other explicitly unnumbered entries. */
+	if (ino == 0) {
+		*ino_new = 0;
+		return (ARCHIVE_OK);
+	}
+
+	/* An ordinary in-range entry does not need identity translation. */
+	if (ino > 0 && ino <= 0xffffffff && archive_entry_nlink(entry) < 2) {
+		*ino_new = (uint32_t)ino;
+		return (ARCHIVE_OK);
+	}
+
+	/* Reuse the archive value for a repeated hardlink identity. */
+	if (archive_entry_nlink(entry) >= 2) {
+		for (i = 0; i < cpio->ino_list_next; ++i) {
+			if (cpio->ino_list[i].devmajor == devmajor &&
+			    cpio->ino_list[i].devminor == devminor &&
+			    cpio->ino_list[i].old == ino) {
+				*ino_new = cpio->ino_list[i].new;
+				return (ARCHIVE_OK);
+			}
+		}
+	}
+
+	/* Zero is reserved for entries with no inode and for TRAILER!!!. */
+	if (cpio->ino_next == 0)
+		return (ARCHIVE_FAILED);
+
+	*ino_new = cpio->ino_next--;
+
+	/* A single-link overflow entry needs no stable lookup record. */
+	if (archive_entry_nlink(entry) < 2)
+		return (ARCHIVE_OK);
+
+	if (cpio->ino_list_size <= cpio->ino_list_next) {
+		size_t newsize, size;
+		void *newlist;
+
+		if (cpio->ino_list_size < 512)
+			newsize = 512;
+		else if (archive_ckd_mul_size(&newsize,
+		    cpio->ino_list_size, 2))
+			return (ARCHIVE_FATAL);
+		if (archive_ckd_mul_size(&size,
+		    newsize, sizeof(cpio->ino_list[0])))
+			return (ARCHIVE_FATAL);
+
+		newlist = realloc(cpio->ino_list, size);
+		if (newlist == NULL)
+			return (ARCHIVE_FATAL);
+
+		cpio->ino_list_size = newsize;
+		cpio->ino_list = newlist;
+	}
+
+	cpio->ino_list[cpio->ino_list_next].devmajor = devmajor;
+	cpio->ino_list[cpio->ino_list_next].devminor = devminor;
+	cpio->ino_list[cpio->ino_list_next].old = ino;
+	cpio->ino_list[cpio->ino_list_next].new = *ino_new;
+	++cpio->ino_list_next;
+	return (ARCHIVE_OK);
+}
